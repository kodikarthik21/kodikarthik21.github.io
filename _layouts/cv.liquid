---
layout: default
---
{% comment %}
  Two-column CV: header (name, subtitle, photo), divider, main column
  (education, experience, publications, awards) and a sidebar
  (links, contact, skills, interests, languages, PDF). Reads _data/cv.yml.
{% endcomment %}
{% assign cv = site.data.cv.cv %}
{% assign s = cv.sections %}

<div class="cvx">
  <div class="cvx-header">
    <div>
      <h1 class="cvx-name">{% assign nm = cv.name | split: ' ' %}{% for w in nm %}<span>{{ w }}</span>{% endfor %}</h1>
      <p class="cvx-subtitle">Carnegie Mellon University, Pittsburgh, PA</p>
    </div>
    <img class="cvx-avatar" src="{{ '/assets/img/prof_pic.jpg' | relative_url }}" alt="{{ cv.name }}">
  </div>

  <div class="cvx-divider"></div>

  <div class="cvx-content">
    <div class="cvx-main">
      {% if s.Education %}
        <div class="cvx-block">
          <h2>Education</h2>
          {% for e in s.Education %}
            <div class="cvx-item">
              <h3>{{ e.institution }}</h3>
              <p class="cvx-meta">{% include cv/fmt_date.liquid d=e.start_date fmt='%B %Y' %} — {% if e.end_date and e.end_date != '' %}{% include cv/fmt_date.liquid d=e.end_date fmt='%B %Y' %}{% else %}Present{% endif %}{% if e.location %} ({{ e.location }}){% endif %}</p>
              <p>{{ e.studyType }}, {{ e.area }}{% if e.score %} (GPA: {{ e.score }}){% endif %}</p>
              {% if e.highlights %}<ul>{% for h in e.highlights %}<li>{{ h | markdownify | remove: '<p>' | remove: '</p>' }}</li>{% endfor %}</ul>{% endif %}
            </div>
          {% endfor %}
        </div>
      {% endif %}

      {% if s.Experience %}
        <div class="cvx-block">
          <h2>Experience</h2>
          {% for e in s.Experience %}
            <div class="cvx-item">
              <h3>{{ e.position }}, {{ e.company }}</h3>
              <p class="cvx-meta">{% include cv/fmt_date.liquid d=e.start_date fmt='%B %Y' %} — {% if e.end_date and e.end_date != '' %}{% include cv/fmt_date.liquid d=e.end_date fmt='%B %Y' %}{% else %}Present{% endif %}{% if e.location %} ({{ e.location }}){% endif %}</p>
              {% if e.highlights %}<ul>{% for h in e.highlights %}<li>{{ h | markdownify | remove: '<p>' | remove: '</p>' }}</li>{% endfor %}</ul>{% endif %}
            </div>
          {% endfor %}
        </div>
      {% endif %}

      {% if s.Publications %}
        <div class="cvx-block">
          <h2>Publications</h2>
          {% for e in s.Publications %}
            <div class="cvx-item">
              <h3>{% if e.url %}<a href="{{ e.url }}" target="_blank" rel="noopener">{{ e.title }}</a>{% else %}{{ e.title }}{% endif %}</h3>
              <p class="cvx-meta">{{ e.publisher }}, {{ e.date }}</p>
              {% if e.summary %}<p>{{ e.summary }}</p>{% endif %}
            </div>
          {% endfor %}
        </div>
      {% endif %}

      {% if s.Awards %}
        <div class="cvx-block">
          <h2>Awards</h2>
          <ul class="cvx-list">
            {% for e in s.Awards %}
              <li><b>{{ e.title }}</b> — {{ e.awarder }}, {{ e.date }}{% if e.summary %}. {{ e.summary }}{% endif %}</li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}
    </div>

    <div class="cvx-sidebar">
      <div class="cvx-block">
        <h2>Links</h2>
        <div class="cvx-links">
          {% for n in cv.social_networks %}
            {% if n.network == 'GitHub' %}<a href="https://github.com/{{ n.username }}" target="_blank" rel="noopener">GitHub</a>
            {% elsif n.network == 'LinkedIn' %}<a href="https://www.linkedin.com/in/{{ n.username }}" target="_blank" rel="noopener">LinkedIn</a>{% endif %}
          {% endfor %}
          <a href="{{ '/' | relative_url }}">Portfolio</a>
        </div>
      </div>

      <div class="cvx-block">
        <h2>Contact</h2>
        <p><a href="mailto:{{ cv.email }}">{{ cv.email }}</a></p>
        {% if cv.location %}<p class="cvx-meta">{{ cv.location }}</p>{% endif %}
      </div>

      {% if s.Skills %}
        <div class="cvx-block">
          <h2>Skills</h2>
          {% for k in s.Skills %}<p><b>{{ k.name }}:</b> {{ k.keywords }}</p>{% endfor %}
        </div>
      {% endif %}

      {% if s.Interests %}
        <div class="cvx-block">
          <h2>Interests</h2>
          {% for k in s.Interests %}<p>{{ k.keywords }}</p>{% endfor %}
        </div>
      {% endif %}

      {% if s.Languages %}
        <div class="cvx-block">
          <h2>Languages</h2>
          <p>{% for k in s.Languages %}{{ k.name }} ({{ k.summary }}){% unless forloop.last %}, {% endunless %}{% endfor %}</p>
        </div>
      {% endif %}

      {% if page.cv_pdf %}
        <div class="cvx-block cvx-download">
          <a href="{{ page.cv_pdf | relative_url }}" target="_blank" rel="noopener"><i class="fa-solid fa-download"></i> Download CV as PDF</a>
        </div>
      {% endif %}
    </div>
  </div>
</div>
