{% comment %}
  Unified publications entry renderer for both RenderCV and JSONResume formats
{% endcomment %}

<ul class="card-text font-weight-light list-group list-group-flush">
  {% for entry in entries %}
    {% assign when = entry.releaseDate | default: entry.date | default: '' | split: '-' | first %}
    {% assign ptitle = entry.title | default: entry.name %}
    {% capture sub %}{% if entry.publisher %}<em>{{ entry.publisher }}</em>{% endif %}{% endcapture %}
    <li class="list-group-item cv-entry">
      {% include cv/entry_head.liquid title=ptitle url=entry.url when=when sub=sub %}
      {% if entry.summary %}
        <div class="cv-text">{{ entry.summary | markdownify | remove: '<p>' | remove: '</p>' }}</div>
      {% endif %}
    </li>
  {% endfor %}
</ul>
