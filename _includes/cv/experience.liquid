{% comment %}
  Unified work/experience entry renderer for both RenderCV and JSONResume formats
{% endcomment %}

<ul class="card-text font-weight-light list-group list-group-flush">
  {% for entry in entries %}
    {% assign start = entry.start_date | default: entry.startDate %}
    {% assign end = entry.end_date | default: entry.endDate %}
    {% assign company = entry.name | default: entry.company | default: entry.organization %}
    <li class="list-group-item cv-entry">
      {% include cv/entry_head.liquid title=entry.position url=entry.url start=start end=end sub=company location=entry.location %}
      {% if entry.summary %}
        <div class="cv-sub"><em>{{ entry.summary | markdownify | remove: '<p>' | remove: '</p>' }}</em></div>
      {% endif %}
      {% if entry.highlights %}
        <ul class="cv-items">
          {% for item in entry.highlights %}
            <li>{{ item | markdownify | remove: '<p>' | remove: '</p>' }}</li>
          {% endfor %}
        </ul>
      {% endif %}
    </li>
  {% endfor %}
</ul>
