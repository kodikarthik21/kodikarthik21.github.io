{% comment %}
  Unified education entry renderer for both RenderCV and JSONResume formats
{% endcomment %}

<ul class="card-text font-weight-light list-group list-group-flush">
  {% for entry in entries %}
    {% assign start = entry.start_date | default: entry.startDate %}
    {% assign end = entry.end_date | default: entry.endDate %}
    {% capture sub %}{{ entry.studyType | default: entry.degree }}{% if entry.area %}, {{ entry.area }}{% endif %}{% endcapture %}
    <li class="list-group-item cv-entry">
      {% include cv/entry_head.liquid title=entry.institution url=entry.url start=start end=end sub=sub location=entry.location %}
      {% if entry.courses or entry.highlights %}
        <ul class="cv-items">
          {% for item in entry.courses %}<li>{{ item }}</li>{% endfor %}
          {% for item in entry.highlights %}
            <li>{{ item | markdownify | remove: '<p>' | remove: '</p>' }}</li>
          {% endfor %}
        </ul>
      {% endif %}
    </li>
  {% endfor %}
</ul>
