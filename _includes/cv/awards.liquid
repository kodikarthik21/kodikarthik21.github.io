{% comment %}
  Unified awards entry renderer for both RenderCV and JSONResume formats
{% endcomment %}

<ul class="card-text font-weight-light list-group list-group-flush">
  {% for entry in entries %}
    {% assign when = entry.date | default: entry.awardDate | default: '' | split: '-' | first %}
    <li class="list-group-item cv-entry">
      {% include cv/entry_head.liquid title=entry.title url=entry.url when=when sub=entry.awarder %}
      {% if entry.summary %}
        <div class="cv-text">{{ entry.summary | markdownify | remove: '<p>' | remove: '</p>' }}</div>
      {% endif %}
    </li>
  {% endfor %}
</ul>
